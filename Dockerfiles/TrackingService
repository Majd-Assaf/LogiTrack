FROM mcr.microsoft.com/dotnet/runtime:8.0 AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/TrackingService/TrackingService.Worker/*.csproj ./src/TrackingService/TrackingService.Worker/
RUN dotnet restore src/TrackingService/TrackingService.Worker/TrackingService.Worker.csproj
COPY . .
WORKDIR /src/TrackingService/TrackingService.Worker
RUN dotnet publish -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "TrackingService.Worker.dll"]
