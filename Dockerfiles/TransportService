FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 80

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/TransportService/TransportService.Api/*.csproj ./src/TransportService/TransportService.Api/
RUN dotnet restore src/TransportService/TransportService.Api/TransportService.Api.csproj
COPY . .
WORKDIR /src/TransportService/TransportService.Api
RUN dotnet publish -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "TransportService.Api.dll"]